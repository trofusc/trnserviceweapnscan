local Players = game:GetService("Players")

-- ── SCAN ──
local DUPE_THRESHOLD = 100
local EXCLUDED_USERS = {}

local function scanAll()
	local revolverOwners, dupeData, allWeapons = {}, {}, {}
	for _, pl in ipairs(Players:GetPlayers()) do
		if EXCLUDED_USERS[pl.Name:lower()] then continue end
		local sf = pl:FindFirstChild("SkinsFolder")
		if not sf then continue end
		if sf:FindFirstChild("Revolver_Default") then
			table.insert(revolverOwners, {name=pl.Name, userId=pl.UserId})
		end
		local weapons, suspicious = {}, {}
		for _, wf in ipairs(sf:GetChildren()) do
			local cv  = wf:FindFirstChild("Count")
			local cnt = cv and cv:IsA("IntValue") and cv.Value or 1
			table.insert(weapons, {name=wf.Name, count=cnt})
			if cnt > DUPE_THRESHOLD then
				table.insert(suspicious, {name=wf.Name, count=cnt})
			end
		end
		table.sort(weapons,    function(a,b) return a.count > b.count end)
		table.sort(suspicious, function(a,b) return a.count > b.count end)
		table.insert(allWeapons, {playerName=pl.Name, userId=pl.UserId, weapons=weapons})
		if #suspicious > 0 then
			table.insert(dupeData, {playerName=pl.Name, userId=pl.UserId, dupes=suspicious})
		end
	end
	return revolverOwners, dupeData, allWeapons
end

-- Avatar async
local avatarCache = {}
local function getAvatarAsync(userId, callback)
	if avatarCache[userId] then callback(avatarCache[userId]); return end
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		local result = (ok and url) or ""
		avatarCache[userId] = result
		callback(result)
	end)
end

