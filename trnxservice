local DupesListSection = nil

local function rebuildDupesList()
	if DupesListSection then pcall(function() DupesListSection:Destroy() end) end
	DupesListSection = DupesTab:Section({ Title="Jugadores sospechosos", Box=true, BoxBorder=true, Opened=true })
	if #dupeData == 0 then
		DupesListSection:Section({ Title="✓  Sin jugadores sospechosos.", TextSize=13, TextTransparency=0.4 })
		return
	end
	for _, e in ipairs(dupeData) do
		local lines = {}
		for _, w in ipairs(e.dupes) do table.insert(lines, "› "..w.name.."  ×"..w.count) end
		local para = DupesListSection:Paragraph({
			Title="⚠ "..e.playerName, Desc=#e.dupes.." items\n"..table.concat(lines,"\n"),
			Image="solar:danger-triangle-bold", ImageSize=36,
			Buttons={{
				Title="Copiar", Icon="copy",
				Callback=function()
					pcall(function() setclipboard(e.playerName.."\n"..table.concat(lines,"\n")) end)
					WindUI:Notify({ Title="Copiado", Content=e.playerName, Duration=2 })
				end,
			}},
		})
		getAvatarAsync(e.userId, function(url)
			if url ~= "" and para and para.SetImage then pcall(function() para:SetImage(url) end) end
		end)
	end
end

DupesTab:Button({
