local function rebuildScannerSections()
	-- Stats
	pcall(function()
		ScanStatsSection:SetTitle(
			"Jugadores: "..#Players:GetPlayers()
			.."   |   Revolver: "..#revolverOwners
			.."   |   Dupes: "..#dupeData
		)
	end)

	-- Revolver Owners
	if RevSection then pcall(function() RevSection:Destroy() end) end
	RevSection = ScannerTab:Section({ Title="Revolver Default Owners", Box=true, BoxBorder=true, Opened=true })
	if #revolverOwners == 0 then
		RevSection:Section({ Title="Sin propietarios.", TextSize=13, TextTransparency=0.4 })
	else
		for _, p in ipairs(revolverOwners) do
			local para = RevSection:Paragraph({ Title=p.name, Desc="✓  Tiene Revolver_Default", Image="solar:user-bold", ImageSize=36 })
			getAvatarAsync(p.userId, function(url)
				if url ~= "" and para and para.SetImage then pcall(function() para:SetImage(url) end) end
			end)
		end
	end

	-- Dupes en scanner
	if DupeScanSection then pcall(function() DupeScanSection:Destroy() end) end
	DupeScanSection = ScannerTab:Section({ Title="Dupes +"..DUPE_THRESHOLD, Box=true, BoxBorder=true, Opened=true })
	if #dupeData == 0 then
		DupeScanSection:Section({ Title="✓  Sin dupes detectados.", TextSize=13, TextTransparency=0.4 })
	else
		for _, e in ipairs(dupeData) do
			local lines = {}
			for _, w in ipairs(e.dupes) do table.insert(lines, "› "..w.name.."  ×"..w.count) end
			local para = DupeScanSection:Paragraph({
				Title="⚠ "..e.playerName, Desc=#e.dupes.." items\n"..table.concat(lines,"\n"),
				Image="solar:danger-triangle-bold", ImageSize=36,
				Buttons={{
					Title="Copiar", Icon="copy",
					Callback=function()
						pcall(function() setclipboard(e.playerName.."\n"..table.concat(lines,"\n")) end)
						WindUI:Notify({ Title="Copiado", Content=e.playerName, Duration=2 })
					end,
				}},
			})
			getAvatarAsync(e.userId, function(url)
				if url ~= "" and para and para.SetImage then pcall(function() para:SetImage(url) end) end
			end)
		end
	end
end

