local autoOn, autoThread = false, nil
ConfigTab:Toggle({
	Flag="AutoRefresh", Title="Auto-refresh cada 30s",
	Desc="Escanea automáticamente cada 30 segundos",
	Value=false,
	Callback=function(state)
		autoOn = state
		if state then
			autoThread = task.spawn(function()
				while autoOn do
					task.wait(30)
					if not autoOn then break end
					revolverOwners, dupeData, allWeapons = scanAll()
					rebuildScannerSections()
					rebuildInvList()
					rebuildDupesList()
					WindUI:Notify({ Title="Auto-refresh", Content="Rev: "..#revolverOwners.."  Dupes: "..#dupeData, Duration=3 })
				end
			end)
		elseif autoThread then
			task.cancel(autoThread); autoThread = nil
		end
	end,
})

ConfigTab:Space()

ConfigTab:Keybind({
	Flag="ToggleKey", Title="Toggle Panel",
	Desc="Tecla para abrir/cerrar",
	Value="RightShift",
	Callback=function(v)
		Window:SetToggleKey(Enum.KeyCode[v])
	end,
})

