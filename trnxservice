	Callback=function(val)
		if val and val ~= "" then
			EXCLUDED_USERS[val:lower()] = true
			revolverOwners, dupeData, allWeapons = scanAll()
			rebuildScannerSections()
			rebuildInvList()
			rebuildDupesList()
			WindUI:Notify({ Title="Excluido", Content=val.." eliminado de todos los listados.", Duration=3 })
		end
	end,
})

