		nameLbl.TextTruncate = Enum.TextTruncate.AtEnd; nameLbl.ZIndex = 104; nameLbl.Parent = row
		local cntLbl = Instance.new("TextLabel")
		cntLbl.Size = UDim2.new(0,80,1,0); cntLbl.Position = UDim2.new(1,-88,0,0)
		cntLbl.BackgroundTransparency = 1; cntLbl.Text = "x"..weapon.count..(isDupe and " ⚠" or "")
		cntLbl.TextColor3 = isDupe and COL_DUP or COL_MUT; cntLbl.Font = Enum.Font.GothamBold
		cntLbl.TextSize = 12; cntLbl.TextXAlignment = Enum.TextXAlignment.Right
		cntLbl.ZIndex = 104; cntLbl.Parent = row
	end

	local function renderWeapons(filter)
		for _, ch in ipairs(scroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end
		local ord = 0
		for _, w in ipairs(e.weapons) do
			local isDupe = w.count > DUPE_THRESHOLD
			if filter == "all" or (filter == "dupes" and isDupe) then
				ord += 1; mkWeaponRow(w, isDupe, ord)
			end
		end
	end

	local function mkTabBtn(title, isActive)
		local tb = Instance.new("TextButton")
		tb.Size = UDim2.new(0,100,1,0)
		tb.BackgroundColor3 = isActive and BG_TABA or BG_TAB
		tb.Text = title; tb.TextColor3 = COL_TXT
		tb.Font = Enum.Font.GothamBold; tb.TextSize = 11
		tb.BorderSizePixel = 0; tb.ZIndex = 103; tb.Parent = tabBar
		local tc = Instance.new("UICorner"); tc.CornerRadius = UDim.new(0,8); tc.Parent = tb
		return tb
	end

	local btnAll   = mkTabBtn("Todas ("..#e.weapons..")", true)
	local btnDupes = mkTabBtn("Dupes ("..dupeCount2..")",   false)
	btnAll.MouseButton1Click:Connect(function()
		btnAll.BackgroundColor3 = BG_TABA; btnDupes.BackgroundColor3 = BG_TAB
		renderWeapons("all")
	end)
	btnDupes.MouseButton1Click:Connect(function()
		btnDupes.BackgroundColor3 = BG_TABA; btnAll.BackgroundColor3 = BG_TAB
		renderWeapons("dupes")
	end)

	local copyBtn = Instance.new("TextButton")
	copyBtn.Size = UDim2.new(1,-24,0,32); copyBtn.Position = UDim2.new(0,12,1,-44)
	copyBtn.BackgroundColor3 = BG_COPY; copyBtn.Text = "Copiar inventario"
	copyBtn.TextColor3 = COL_ACC; copyBtn.Font = Enum.Font.GothamBold
	copyBtn.TextSize = 12; copyBtn.BorderSizePixel = 0
	copyBtn.ZIndex = 103; copyBtn.Parent = popup
	local cbc = Instance.new("UICorner"); cbc.CornerRadius = UDim.new(0,8); cbc.Parent = copyBtn
	local cbs = Instance.new("UIStroke"); cbs.Color = COL_BRD; cbs.Thickness = 1; cbs.Parent = copyBtn
	copyBtn.MouseButton1Click:Connect(function()
		local lines = {e.playerName.." — "..#e.weapons.." armas"}
		for _, w in ipairs(e.weapons) do
			table.insert(lines, w.name.."  ×"..w.count..(w.count > DUPE_THRESHOLD and " [DUPE]" or ""))
		end
		pcall(function() setclipboard(table.concat(lines, "\n")) end)
		WindUI:Notify({ Title="Copiado", Content=e.playerName, Duration=2 })
	end)

	renderWeapons("all")
	game:GetService("TweenService"):Create(popup,
		TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
		{Size=UDim2.new(0,480,0,520)}
	):Play()
end

local function rebuildInvList()
	if InvListSection then pcall(function() InvListSection:Destroy() end) end
	InvListSection = InventarioTab:Section({ Title="Jugadores", Box=true, BoxBorder=true, Opened=true })
	if #allWeapons == 0 then
		InvListSection:Section({ Title="No hay jugadores con SkinsFolder.", TextSize=13, TextTransparency=0.4 })
		return
	end
	for _, e in ipairs(allWeapons) do
		local dupeCount3 = 0
		for _, w in ipairs(e.weapons) do if w.count > DUPE_THRESHOLD then dupeCount3 += 1 end end
		local desc = #e.weapons.." armas"
		if dupeCount3 > 0 then desc = desc.."  |  ⚠ "..dupeCount3.." dupes" end
		local para = InvListSection:Paragraph({
			Title=e.playerName, Desc=desc,
			Image="solar:user-bold", ImageSize=36,
			Buttons={{
				Title="Ver armas", Icon="solar:box-bold",
				Callback=function()
					playSound(SFX.click, 1.2, 1)
					if _G.TronixInvPopup then
						pcall(function() _G.TronixInvPopup:Destroy() end)
						_G.TronixInvPopup = nil
					end
					buildInvPopup(e)
				end,
			}},
		})
		getAvatarAsync(e.userId, function(url)
			if url ~= "" and para and para.SetImage then pcall(function() para:SetImage(url) end) end
		end)
	end
end

InventarioTab:Button({
	Title="Actualizar", Icon="solar:refresh-bold",
	Color=Color3.fromHex("#3b82f6"), Justify="Center",
	Callback=function()
		playSound(SFX.click, 1.2, 1)
		revolverOwners, dupeData, allWeapons = scanAll()
		rebuildInvList()
		WindUI:Notify({ Title="Actualizado", Content=tostring(#allWeapons).." jugadores.", Duration=3 })
	end,
})
InventarioTab:Space()
rebuildInvList()

